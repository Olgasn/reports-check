# Нормализация переводов строк: хранить в репозитории с LF,
# конвертировать для рабочей копии согласно core.autocrlf / eol.

# Автоматическое определение текстовых файлов
* text=auto

# Исходный код .NET — LF
*.cs        text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.razor     text eol=lf
*.cshtml    text eol=lf

# Веб и конфигурация
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.template  text eol=lf
*.sql       text eol=lf

# Скрипты
*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Бинарные файлы — без конвертации
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.nupkg binary
*.dll   binary
*.exe   binary
*.pdb   binary
